// Bar Management Dashboard — schema
// Deployed: Postgres (Neon, via Vercel integration) — BARMGMT_DB_CONN.
// Local dev without a real DB: point BARMGMT_DB_CONN at the same Neon instance,
// or set it to a local Postgres. SQLite is no longer supported (dropped once
// deploy happened — money/quantity Float fields carried over, Decimal not
// revisited yet, still an open item).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Core / Auth ───────────────────────────

model Venue {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/Argentina/Cordoba")
  currency  String   @default("ARS")
  createdAt DateTime @default(now())

  users                 User[]
  people                Person[]
  categories            Category[]
  products              Product[]
  suppliers             Supplier[]
  businessDays          BusinessDay[]
  consumptions          Consumption[]
  reorderItems          ReorderItem[]
  purchases             Purchase[]
  adjustments           StockAdjustment[]
  stockPeriods          StockPeriod[]
  auditLogs             AuditLog[]
  glasswareItems        GlasswareItem[]
  glasswareMonthPeriods GlasswareMonthPeriod[]
  feedbackItems         FeedbackItem[]
  barInventoryEntries   BarInventoryEntry[]
  fridgeUnits           FridgeUnit[]
  posSalesPeriods       PosSalesPeriod[]
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id])
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]

  @@index([venueId])
}

enum PersonKind {
  OWNER
  STAFF
  BAND
}

model Person {
  id          String     @id @default(cuid())
  venueId     String
  venue       Venue      @relation(fields: [venueId], references: [id])
  name        String
  kind        PersonKind @default(OWNER)
  avatarColor String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  consumptions    Consumption[]
  fridgeIncidents FridgeIncident[]

  @@index([venueId])
}

// ─────────────────────────── Catalog ───────────────────────────

enum CategoryKind {
  BEVERAGE
  WINE
  COFFEE
  GLASSWARE
  DISPOSABLE
  INGREDIENT
  OTHER
}

model Category {
  id        String       @id @default(cuid())
  venueId   String
  venue     Venue        @relation(fields: [venueId], references: [id])
  name      String
  kind      CategoryKind @default(BEVERAGE)
  parentId  String?
  parent    Category?    @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryParent")
  sortOrder Int          @default(0)

  products  Product[]
  suppliers Supplier[] @relation("SupplierCategories")

  @@index([venueId])
}

enum UnitOfMeasure {
  ML
  UNIDAD
  GRAMOS
  KG
}

enum ContainerType {
  BOTTLE
  CAN
  KEG
  UNIT
}

enum Carbonation {
  CON_GAS
  SIN_GAS
  NA
}

model Product {
  id                    String        @id @default(cuid())
  venueId               String
  venue                 Venue         @relation(fields: [venueId], references: [id])
  categoryId            String
  category              Category      @relation(fields: [categoryId], references: [id])
  name                  String
  unitOfMeasure         UnitOfMeasure @default(ML)
  containerLabel        String?
  containerType         ContainerType @default(BOTTLE)
  servingsPerContainer  Float         @default(1)
  costPricePerContainer Float         @default(0)
  salePricePerServing   Float?
  carbonation           Carbonation   @default(NA)
  servedInProductId     String?
  servedIn              Product?      @relation("ServedIn", fields: [servedInProductId], references: [id])
  servesAs              Product[]     @relation("ServedIn")
  emoji                 String?
  colorHex              String?
  showOnQuickGrid       Boolean       @default(false)
  quickGridSort         Int?
  primarySupplierId     String?
  primarySupplier       Supplier?     @relation(fields: [primarySupplierId], references: [id])
  isSellable            Boolean       @default(true)
  isRecipeIngredient    Boolean       @default(false)
  reorderThreshold      Float?
  currentStock          Float         @default(0)
  attributes            String? // JSON-encoded, kept as string for SQLite/Postgres portability
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Puntos de conteo (Inventario de Barra) -- deliberately separate from
  // servingsPerContainer above, which drives cost/margin math with the true
  // medida count. This is the margin-buffered count (e.g. 10, not 12) used
  // only for daily open-bottle shrinkage detection. Null = "sin configurar"
  // until Pablo/Joan confirm real per-product values -- never guess-fill it.
  countingServingsPerContainer Int?

  // POS ticket código (Ventas POS) -- links this Product to the bar's POS
  // system's own numeric code, e.g. "104". Non-unique on purpose: a code
  // could plausibly cover more than one physical product via a combo line.
  posCode String?

  priceHistory        ProductPriceHistory[]
  consumptions        Consumption[]
  purchases           Purchase[]
  adjustments         StockAdjustment[]
  stockCounts         StockCount[]
  recipe              Recipe?
  usedInRecipes       RecipeIngredient[]
  barInventoryEntries BarInventoryEntry[]
  posSalesLines       PosSalesLine[]

  @@index([venueId])
  @@index([categoryId])
}

enum PriceType {
  COST
  SALE
}

model ProductPriceHistory {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  price         Float
  priceType     PriceType
  effectiveDate DateTime  @default(now())

  @@index([productId])
}

model Supplier {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id])
  name         String
  contactPhone String?
  contactNote  String?
  createdAt    DateTime @default(now())

  categories      Category[]    @relation("SupplierCategories")
  primaryProducts Product[]
  reorderItems    ReorderItem[]
  purchases       Purchase[]

  @@index([venueId])
}

// ─────────────────────────── Daily register ───────────────────────────

enum BusinessDayStatus {
  OPEN
  CLOSED
}

model BusinessDay {
  id       String            @id @default(cuid())
  venueId  String
  venue    Venue             @relation(fields: [venueId], references: [id])
  date     DateTime
  status   BusinessDayStatus @default(OPEN)
  openedAt DateTime          @default(now())
  closedAt DateTime?

  consumptions        Consumption[]
  reorderItems        ReorderItem[]
  barInventoryEntries BarInventoryEntry[]

  @@unique([venueId, date])
}

enum ConsumptionType {
  SALE
  OWNER
  COMP
  BAND_ALLOWANCE
}

model Consumption {
  id               String          @id @default(cuid())
  venueId          String
  venue            Venue           @relation(fields: [venueId], references: [id])
  businessDayId    String
  businessDay      BusinessDay     @relation(fields: [businessDayId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  freeText         String?
  type             ConsumptionType @default(SALE)
  quantity         Float           @default(1)
  personId         String?
  person           Person?         @relation(fields: [personId], references: [id])
  unitPriceCharged Float           @default(0)
  unitCost         Float           @default(0)
  createdAt        DateTime        @default(now())

  @@index([venueId])
  @@index([businessDayId])
  @@index([productId])
}

enum ReorderStatus {
  PENDIENTE
  PEDIDO
  RECIBIDO
}

model ReorderItem {
  id            String        @id @default(cuid())
  venueId       String
  venue         Venue         @relation(fields: [venueId], references: [id])
  businessDayId String?
  businessDay   BusinessDay?  @relation(fields: [businessDayId], references: [id])
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  supplierLabel String?
  name          String
  quantity      Float         @default(1)
  status        ReorderStatus @default(PENDIENTE)
  createdAt     DateTime      @default(now())

  @@index([venueId])
}

// ─────────────────────────── Stock ledger ───────────────────────────

model Purchase {
  id            String       @id @default(cuid())
  venueId       String
  venue         Venue        @relation(fields: [venueId], references: [id])
  stockPeriodId String?
  stockPeriod   StockPeriod? @relation(fields: [stockPeriodId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  supplierId    String?
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  quantity      Float
  unitCost      Float
  invoiceRef    String?
  purchaseDate  DateTime     @default(now())

  @@index([venueId])
  @@index([productId])
}

enum StockAdjustmentReason {
  BREAKAGE
  WASTE
  RECOUNT_CORRECTION
  PERIOD_CLOSE_RECONCILE
  OTHER
}

model StockAdjustment {
  id            String                @id @default(cuid())
  venueId       String
  venue         Venue                 @relation(fields: [venueId], references: [id])
  productId     String
  product       Product               @relation(fields: [productId], references: [id])
  quantityDelta Float
  reason        StockAdjustmentReason
  note          String?
  createdAt     DateTime              @default(now())

  @@index([venueId])
  @@index([productId])
}

enum StockPeriodStatus {
  OPEN
  CLOSED
}

model StockPeriod {
  id        String            @id @default(cuid())
  venueId   String
  venue     Venue             @relation(fields: [venueId], references: [id])
  label     String
  startDate DateTime          @default(now())
  endDate   DateTime?
  status    StockPeriodStatus @default(OPEN)
  closedAt  DateTime?

  counts    StockCount[]
  purchases Purchase[]

  @@index([venueId])
}

model StockCount {
  id                    String      @id @default(cuid())
  stockPeriodId         String
  stockPeriod           StockPeriod @relation(fields: [stockPeriodId], references: [id])
  productId             String
  product               Product     @relation(fields: [productId], references: [id])
  initialQuantity       Float       @default(0)
  expectedFinalQuantity Float?
  countedFinalQuantity  Float?
  variance              Float?

  @@unique([stockPeriodId, productId])
}

// ─────────────────────────── Recipes ───────────────────────────

model Recipe {
  id            String  @id @default(cuid())
  productId     String  @unique
  product       Product @relation(fields: [productId], references: [id])
  yieldServings Float   @default(1)

  // Ficha técnica (Recetario) — presentational detail on top of the cost
  // recipe above. Photo is a pasted URL for v1 (device upload needs Vercel
  // Blob, not wired yet — see TECHNICAL-GUIDE.md).
  photoUrl         String?
  description      String?
  preparationSteps String?
  garnish          String?
  glassLabel       String?

  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id                  String        @id @default(cuid())
  recipeId            String
  recipe              Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredientProduct   Product       @relation(fields: [ingredientProductId], references: [id])
  quantity            Float
  uom                 UnitOfMeasure @default(ML)

  @@index([recipeId])
}

// ─────────────────────────── Audit ───────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       String? // JSON-encoded
  createdAt  DateTime @default(now())

  @@index([venueId])
}

// ─────────────────────────── Cristalería y Vajilla ───────────────────────────
// Separate from Product/StockPeriod on purpose: this tracks glassware/tableware
// par-level counts by physical location (Barra vs Depósito), one printable
// sheet per month with every week of that month shown side by side — a
// different workflow from the bottle/spirit stock ledger, matching Pablo's
// existing paper "Control Semanal de Stock" sheet.

enum GlasswareLocation {
  BARRA
  DEPOSITO
}

model GlasswareItem {
  id        String            @id @default(cuid())
  venueId   String
  venue     Venue             @relation(fields: [venueId], references: [id])
  code      String
  name      String
  location  GlasswareLocation
  stockBase Float             @default(0)
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  counts GlasswareCount[]

  @@index([venueId])
}

enum GlasswareMonthStatus {
  OPEN
  CLOSED
}

model GlasswareMonthPeriod {
  id        String               @id @default(cuid())
  venueId   String
  venue     Venue                @relation(fields: [venueId], references: [id])
  label     String
  status    GlasswareMonthStatus @default(OPEN)
  startDate DateTime             @default(now())
  closedAt  DateTime?

  weeks GlasswareWeekEntry[]

  @@index([venueId])
}

model GlasswareWeekEntry {
  id            String               @id @default(cuid())
  monthPeriodId String
  monthPeriod   GlasswareMonthPeriod @relation(fields: [monthPeriodId], references: [id])
  weekNumber    Int
  label         String
  createdAt     DateTime             @default(now())

  counts GlasswareCount[]

  @@unique([monthPeriodId, weekNumber])
}

model GlasswareCount {
  id              String             @id @default(cuid())
  weekEntryId     String
  weekEntry       GlasswareWeekEntry @relation(fields: [weekEntryId], references: [id], onDelete: Cascade)
  itemId          String
  item            GlasswareItem      @relation(fields: [itemId], references: [id])
  countedQuantity Float

  @@unique([weekEntryId, itemId])
}

// ─────────────────────────── Feedback ───────────────────────────
// Pablo's channel for bugs/feature requests/workarounds back to Joan. Status
// (NEW/IN_PROGRESS/DONE/WONT_FIX) doubles as the running log of what's been
// asked for, what's being worked on, and what hasn't been touched yet — no
// separate log file to keep in sync.

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  WORKAROUND
  QUESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  WONT_FIX
}

model FeedbackItem {
  id                String         @id @default(cuid())
  venueId           String
  venue             Venue          @relation(fields: [venueId], references: [id])
  type              FeedbackType
  title             String
  description       String
  status            FeedbackStatus @default(NEW)
  submittedBy       String?
  screenshotDataUrl String? // base64 data: URI, client-compressed before upload -- no Blob storage wired yet
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  resolvedAt        DateTime?

  @@index([venueId])
}

// ─────────────────────────── Inventario de Barra (puntos) ───────────────────────────
// Daily open-bottle shrinkage-detection layer, separate from Stock semanal
// (StockPeriod/StockCount, the weekly all-categories physical count). Only
// covers the 8 point-tracked liquor categories (Ron, Vodka, Whisky, Tequila,
// Mezcal, Ginebra, Coñac/Brandy, Licor). Reuses the existing BusinessDay as
// the daily anchor -- Registro already opens/closes one per date.
// ventaPunto is a MANUAL tally (staff mark points as they pour, enter the
// day's total at shift close) -- deliberately NOT derived from Consumption,
// since the entire point of this SOP is catching a pour that never got rung
// up digitally. finalTeorico/variance are computed at read time, never
// stored, matching this app's established convention (see lib/pricing.ts).

model BarInventoryEntry {
  id              String      @id @default(cuid())
  venueId         String
  venue           Venue       @relation(fields: [venueId], references: [id])
  businessDayId   String
  businessDay     BusinessDay @relation(fields: [businessDayId], references: [id])
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  initialQuantity Float       @default(0) // points (tenths of a container)
  entradas        Float       @default(0) // points
  ventaPunto      Float       @default(0) // points, manual tally
  countedPhysical Float? // points, entered at shift close
  createdAt       DateTime    @default(now())

  @@unique([businessDayId, productId])
  @@index([venueId])
  @@index([productId])
}

// ─────────────────────────── Control Temperatura Heladeras ───────────────────────────
// Weekly fridge/cooler temperature log, matching Pablo's paper sheet.
// Status (verde/amarillo/rojo/sin lectura) is computed at read time from
// tempC, never stored -- same convention as Precios/BarInventoryEntry.

model FridgeUnit {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  code      String // "H1".."H6"
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tempEntries FridgeTempEntry[]
  incidents   FridgeIncident[]

  @@index([venueId])
}

model FridgeTempEntry {
  id     String     @id @default(cuid())
  unitId String
  unit   FridgeUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date   DateTime
  tempC  Float? // null = "sin lectura"

  @@unique([unitId, date])
  @@index([unitId])
}

model FridgeIncident {
  id                  String     @id @default(cuid())
  unitId              String
  unit                FridgeUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date                DateTime
  tempRecorded        Float?
  actionTaken         String
  responsiblePersonId String?
  responsiblePerson   Person?    @relation(fields: [responsiblePersonId], references: [id])
  createdAt           DateTime   @default(now())

  @@index([unitId])
}

// ─────────────────────────── Ventas POS ───────────────────────────
// Weekly/irregular-period sales totals transcribed by hand from the POS
// system's own printed "TOTALES" ticket. Categories are the POS system's
// OWN taxonomy (Cervezas, Chopp, Jarras, ...) -- intentionally separate from
// Category.kind, which serves internal stock/cost categorization instead.
// % share, cross-check badges and reconciliation variance are computed at
// read time, never stored -- same convention as every other module.

enum PosSalesPeriodStatus {
  OPEN
  CLOSED
}

model PosSalesPeriod {
  id            String               @id @default(cuid())
  venueId       String
  venue         Venue                @relation(fields: [venueId], references: [id])
  label         String // "18/07/26 19:55 hs a 25/07/26 (8 días)" -- irregular, as transcribed
  startAt       DateTime
  endAt         DateTime
  status        PosSalesPeriodStatus @default(OPEN)
  totalUnidades Float? // grand total as printed -- cross-check vs sum(lines)
  notes         String?
  createdAt     DateTime             @default(now())
  closedAt      DateTime?

  categories PosSalesCategory[]

  @@index([venueId])
  @@index([startAt])
}

model PosSalesCategory {
  id          String         @id @default(cuid())
  periodId    String
  period      PosSalesPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name        String // POS's own taxonomy, free text
  totalTicket Float? // category subtotal as printed -- cross-check vs sum(lines)
  sortOrder   Int            @default(0)

  lines PosSalesLine[]

  @@unique([periodId, name])
  @@index([periodId])
}

model PosSalesLine {
  id               String           @id @default(cuid())
  categoryId       String
  category         PosSalesCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  posCode          String
  descripcion      String
  unidadesVendidas Float
  productId        String? // null = "no match, descripción only"
  product          Product?         @relation(fields: [productId], references: [id])
  createdAt        DateTime         @default(now())

  @@index([categoryId])
  @@index([posCode])
  @@index([productId])
}
