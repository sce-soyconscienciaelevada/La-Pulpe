// Bar Management Dashboard — schema
// Deployed: Postgres (Neon, via Vercel integration) — BARMGMT_DB_CONN.
// Local dev without a real DB: point BARMGMT_DB_CONN at the same Neon instance,
// or set it to a local Postgres. SQLite is no longer supported (dropped once
// deploy happened — money/quantity Float fields carried over, Decimal not
// revisited yet, still an open item).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Core / Auth ───────────────────────────

model Venue {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/Argentina/Cordoba")
  currency  String   @default("ARS")
  createdAt DateTime @default(now())

  users         User[]
  people        Person[]
  categories    Category[]
  products      Product[]
  suppliers     Supplier[]
  businessDays  BusinessDay[]
  consumptions  Consumption[]
  reorderItems  ReorderItem[]
  purchases     Purchase[]
  adjustments   StockAdjustment[]
  stockPeriods  StockPeriod[]
  auditLogs     AuditLog[]
  glasswareItems        GlasswareItem[]
  glasswareMonthPeriods GlasswareMonthPeriod[]
  feedbackItems         FeedbackItem[]
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id])
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]

  @@index([venueId])
}

enum PersonKind {
  OWNER
  STAFF
  BAND
}

model Person {
  id          String     @id @default(cuid())
  venueId     String
  venue       Venue      @relation(fields: [venueId], references: [id])
  name        String
  kind        PersonKind @default(OWNER)
  avatarColor String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  consumptions Consumption[]

  @@index([venueId])
}

// ─────────────────────────── Catalog ───────────────────────────

enum CategoryKind {
  BEVERAGE
  WINE
  COFFEE
  GLASSWARE
  DISPOSABLE
  INGREDIENT
  OTHER
}

model Category {
  id        String       @id @default(cuid())
  venueId   String
  venue     Venue        @relation(fields: [venueId], references: [id])
  name      String
  kind      CategoryKind @default(BEVERAGE)
  parentId  String?
  parent    Category?    @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryParent")
  sortOrder Int          @default(0)

  products  Product[]
  suppliers Supplier[]   @relation("SupplierCategories")

  @@index([venueId])
}

enum UnitOfMeasure {
  ML
  UNIDAD
  GRAMOS
  KG
}

enum ContainerType {
  BOTTLE
  CAN
  KEG
  UNIT
}

enum Carbonation {
  CON_GAS
  SIN_GAS
  NA
}

model Product {
  id                    String        @id @default(cuid())
  venueId               String
  venue                 Venue         @relation(fields: [venueId], references: [id])
  categoryId            String
  category              Category      @relation(fields: [categoryId], references: [id])
  name                  String
  unitOfMeasure         UnitOfMeasure @default(ML)
  containerLabel        String?
  containerType         ContainerType @default(BOTTLE)
  servingsPerContainer  Float         @default(1)
  costPricePerContainer Float         @default(0)
  salePricePerServing   Float?
  carbonation           Carbonation   @default(NA)
  servedInProductId     String?
  servedIn              Product?      @relation("ServedIn", fields: [servedInProductId], references: [id])
  servesAs              Product[]     @relation("ServedIn")
  emoji                 String?
  colorHex              String?
  showOnQuickGrid       Boolean       @default(false)
  quickGridSort         Int?
  primarySupplierId     String?
  primarySupplier       Supplier?     @relation(fields: [primarySupplierId], references: [id])
  isSellable            Boolean       @default(true)
  isRecipeIngredient    Boolean       @default(false)
  reorderThreshold      Float?
  currentStock          Float         @default(0)
  attributes            String? // JSON-encoded, kept as string for SQLite/Postgres portability
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  priceHistory      ProductPriceHistory[]
  consumptions      Consumption[]
  purchases         Purchase[]
  adjustments       StockAdjustment[]
  stockCounts       StockCount[]
  recipe            Recipe?
  usedInRecipes     RecipeIngredient[]

  @@index([venueId])
  @@index([categoryId])
}

enum PriceType {
  COST
  SALE
}

model ProductPriceHistory {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  price         Float
  priceType     PriceType
  effectiveDate DateTime  @default(now())

  @@index([productId])
}

model Supplier {
  id           String     @id @default(cuid())
  venueId      String
  venue        Venue      @relation(fields: [venueId], references: [id])
  name         String
  contactPhone String?
  contactNote  String?
  createdAt    DateTime   @default(now())

  categories       Category[]    @relation("SupplierCategories")
  primaryProducts  Product[]
  reorderItems     ReorderItem[]
  purchases        Purchase[]

  @@index([venueId])
}

// ─────────────────────────── Daily register ───────────────────────────

enum BusinessDayStatus {
  OPEN
  CLOSED
}

model BusinessDay {
  id       String            @id @default(cuid())
  venueId  String
  venue    Venue             @relation(fields: [venueId], references: [id])
  date     DateTime
  status   BusinessDayStatus @default(OPEN)
  openedAt DateTime          @default(now())
  closedAt DateTime?

  consumptions Consumption[]
  reorderItems ReorderItem[]

  @@unique([venueId, date])
}

enum ConsumptionType {
  SALE
  OWNER
  COMP
  BAND_ALLOWANCE
}

model Consumption {
  id               String          @id @default(cuid())
  venueId          String
  venue            Venue           @relation(fields: [venueId], references: [id])
  businessDayId    String
  businessDay      BusinessDay     @relation(fields: [businessDayId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  freeText         String?
  type             ConsumptionType @default(SALE)
  quantity         Float           @default(1)
  personId         String?
  person           Person?         @relation(fields: [personId], references: [id])
  unitPriceCharged Float           @default(0)
  unitCost         Float           @default(0)
  createdAt        DateTime        @default(now())

  @@index([venueId])
  @@index([businessDayId])
  @@index([productId])
}

enum ReorderStatus {
  PENDIENTE
  PEDIDO
  RECIBIDO
}

model ReorderItem {
  id            String        @id @default(cuid())
  venueId       String
  venue         Venue         @relation(fields: [venueId], references: [id])
  businessDayId String?
  businessDay   BusinessDay?  @relation(fields: [businessDayId], references: [id])
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  supplierLabel String?
  name          String
  quantity      Float         @default(1)
  status        ReorderStatus @default(PENDIENTE)
  createdAt     DateTime      @default(now())

  @@index([venueId])
}

// ─────────────────────────── Stock ledger ───────────────────────────

model Purchase {
  id            String       @id @default(cuid())
  venueId       String
  venue         Venue        @relation(fields: [venueId], references: [id])
  stockPeriodId String?
  stockPeriod   StockPeriod? @relation(fields: [stockPeriodId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  supplierId    String?
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  quantity      Float
  unitCost      Float
  invoiceRef    String?
  purchaseDate  DateTime     @default(now())

  @@index([venueId])
  @@index([productId])
}

enum StockAdjustmentReason {
  BREAKAGE
  WASTE
  RECOUNT_CORRECTION
  PERIOD_CLOSE_RECONCILE
  OTHER
}

model StockAdjustment {
  id            String                 @id @default(cuid())
  venueId       String
  venue         Venue                  @relation(fields: [venueId], references: [id])
  productId     String
  product       Product                @relation(fields: [productId], references: [id])
  quantityDelta Float
  reason        StockAdjustmentReason
  note          String?
  createdAt     DateTime               @default(now())

  @@index([venueId])
  @@index([productId])
}

enum StockPeriodStatus {
  OPEN
  CLOSED
}

model StockPeriod {
  id        String            @id @default(cuid())
  venueId   String
  venue     Venue             @relation(fields: [venueId], references: [id])
  label     String
  startDate DateTime          @default(now())
  endDate   DateTime?
  status    StockPeriodStatus @default(OPEN)
  closedAt  DateTime?

  counts    StockCount[]
  purchases Purchase[]

  @@index([venueId])
}

model StockCount {
  id                     String      @id @default(cuid())
  stockPeriodId          String
  stockPeriod            StockPeriod @relation(fields: [stockPeriodId], references: [id])
  productId              String
  product                Product     @relation(fields: [productId], references: [id])
  initialQuantity        Float       @default(0)
  expectedFinalQuantity  Float?
  countedFinalQuantity   Float?
  variance               Float?

  @@unique([stockPeriodId, productId])
}

// ─────────────────────────── Recipes ───────────────────────────

model Recipe {
  id             String   @id @default(cuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id])
  yieldServings  Float    @default(1)

  // Ficha técnica (Recetario) — presentational detail on top of the cost
  // recipe above. Photo is a pasted URL for v1 (device upload needs Vercel
  // Blob, not wired yet — see TECHNICAL-GUIDE.md).
  photoUrl           String?
  description        String?
  preparationSteps   String?
  garnish            String?
  glassLabel         String?

  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id                  String        @id @default(cuid())
  recipeId            String
  recipe              Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredientProduct   Product       @relation(fields: [ingredientProductId], references: [id])
  quantity            Float
  uom                 UnitOfMeasure @default(ML)

  @@index([recipeId])
}

// ─────────────────────────── Audit ───────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       String? // JSON-encoded
  createdAt  DateTime @default(now())

  @@index([venueId])
}

// ─────────────────────────── Cristalería y Vajilla ───────────────────────────
// Separate from Product/StockPeriod on purpose: this tracks glassware/tableware
// par-level counts by physical location (Barra vs Depósito), one printable
// sheet per month with every week of that month shown side by side — a
// different workflow from the bottle/spirit stock ledger, matching Pablo's
// existing paper "Control Semanal de Stock" sheet.

enum GlasswareLocation {
  BARRA
  DEPOSITO
}

model GlasswareItem {
  id         String            @id @default(cuid())
  venueId    String
  venue      Venue             @relation(fields: [venueId], references: [id])
  code       String
  name       String
  location   GlasswareLocation
  stockBase  Float             @default(0)
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  counts GlasswareCount[]

  @@index([venueId])
}

enum GlasswareMonthStatus {
  OPEN
  CLOSED
}

model GlasswareMonthPeriod {
  id        String               @id @default(cuid())
  venueId   String
  venue     Venue                @relation(fields: [venueId], references: [id])
  label     String
  status    GlasswareMonthStatus @default(OPEN)
  startDate DateTime             @default(now())
  closedAt  DateTime?

  weeks GlasswareWeekEntry[]

  @@index([venueId])
}

model GlasswareWeekEntry {
  id            String               @id @default(cuid())
  monthPeriodId String
  monthPeriod   GlasswareMonthPeriod @relation(fields: [monthPeriodId], references: [id])
  weekNumber    Int
  label         String
  createdAt     DateTime             @default(now())

  counts GlasswareCount[]

  @@unique([monthPeriodId, weekNumber])
}

model GlasswareCount {
  id             String              @id @default(cuid())
  weekEntryId    String
  weekEntry      GlasswareWeekEntry  @relation(fields: [weekEntryId], references: [id], onDelete: Cascade)
  itemId         String
  item           GlasswareItem       @relation(fields: [itemId], references: [id])
  countedQuantity Float

  @@unique([weekEntryId, itemId])
}

// ─────────────────────────── Feedback ───────────────────────────
// Pablo's channel for bugs/feature requests/workarounds back to Joan. Status
// (NEW/IN_PROGRESS/DONE/WONT_FIX) doubles as the running log of what's been
// asked for, what's being worked on, and what hasn't been touched yet — no
// separate log file to keep in sync.

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  WORKAROUND
  QUESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  WONT_FIX
}

model FeedbackItem {
  id           String         @id @default(cuid())
  venueId      String
  venue        Venue          @relation(fields: [venueId], references: [id])
  type         FeedbackType
  title        String
  description  String
  status       FeedbackStatus @default(NEW)
  submittedBy  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  resolvedAt   DateTime?

  @@index([venueId])
}
